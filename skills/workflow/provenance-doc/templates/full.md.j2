---
template: full
status: {{ status | default('draft') }}
version: {{ version }}
created_at: {{ created_at }}
sealed_at: {{ sealed_at | default('null') }}
owner: {{ owner }}
project: {{ project }}
prior_version: {{ prior_version | default('null') }}
delta_summary_path: {{ delta_summary_path | default('null') }}
{% if extension_sections %}
extension_sections:
{% for ext in extension_sections %}
  - id: {{ ext.id }}
    title: "{{ ext.title }}"
    source: {{ ext.source }}
    status: {{ ext.status }}
    waiver_reason: "{{ ext.waiver_reason | default('') }}"
{% endfor %}
{% else %}
extension_sections: []
{% endif %}
verification:
  remote_command_timeout_sec: {{ verification_timeout | default(300) }}
  fail_closed_on_missing_meta: true
  fail_closed_on_broken_yaml: true
---

